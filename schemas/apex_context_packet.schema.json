{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.apex/apex_context_packet.schema.json",
  "title": "APEX Context Packet V1",
  "type": "object",
  "required": ["schema_version", "engine_version", "status", "blocked_reasons", "input_sha256", "input_truth", "fair_markets", "market_graph", "equivalence_audit", "best_price_alerts", "market_script", "offense_map", "line_discipline", "anomalies", "warnings", "accepted_rows", "quarantined_rows", "quarantine_reasons", "core_coverage", "optional_coverage", "unsupported_families", "semantic_resolutions", "source_odd_rows", "quarantined_source_rows", "upstream_excluded_rows", "total_observed_rows", "semantic_safety_quarantine"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "engine_version": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "PASS_WITH_QUARANTINE", "BLOCKED"]},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_truth": {"type": "object"},
    "fair_markets": {"type": "array"},
    "market_graph": {"type": "object"},
    "equivalence_audit": {"type": "object"},
    "best_price_alerts": {"type": "array"},
    "market_script": {"type": "object"},
    "offense_map": {"type": "object"},
    "line_discipline": {"type": "object"},
    "anomalies": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "accepted_rows": {"type": "integer", "minimum": 0},
    "quarantined_rows": {"type": "array", "items": {"type": "object"}},
    "quarantine_reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "core_coverage": {"type": "object"},
    "optional_coverage": {"type": "object"},
    "unsupported_families": {"type": "array", "items": {"type": "string"}},
    "semantic_resolutions": {"type": "array", "items": {"type": "object"}},
    "source_odd_rows": {"type": "integer", "minimum": 0},
    "quarantined_source_rows": {"type": "integer", "minimum": 0},
    "upstream_excluded_rows": {"type": "integer", "minimum": 0},
    "total_observed_rows": {"type": "integer", "minimum": 0},
    "semantic_safety_quarantine": {"type": "array", "items": {"type": "object"}},
    "upstream_exclusions": {"type": "array", "items": {"type": "object"}},
    "warning_dispositions": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
